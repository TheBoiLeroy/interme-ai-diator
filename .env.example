# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public URL of the deployed app, used in sign-up confirmation emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI providers: set at least one. Only providers with a key show up in the model picker.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: comma-separated model ids to offer for OpenAI and Gemini
# OPENAI_MODELS=gpt-5
# GEMINI_MODELS=gemini-2.5-pro
